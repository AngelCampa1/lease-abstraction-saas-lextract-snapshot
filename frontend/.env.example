# Lextract Frontend - Cloudflare Workers / OpenNext

# Public API base URL. Must include /api/v1 because frontend clients append
# endpoint paths such as /extractions and /leads/magnet.
NEXT_PUBLIC_API_URL=https://api.lextract.io/api/v1

# Neon Auth proxy. Server-side only; do not add NEXT_PUBLIC_.
NEON_AUTH_BASE_URL=https://<project-id>.neonauth.us-east-2.aws.neon.build/neondb/auth
NEON_AUTH_COOKIE_SECRET=<32-plus-character-random-secret>

# Cloudflare D1 marketing Worker used by lead capture and lead magnet routes.
MARKETING_WORKER_URL=https://lextract-marketing-data.<account>.workers.dev
MARKETING_WORKER_SECRET=<shared-worker-secret>

# Cloudflare Turnstile for public marketing form abuse protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<public-turnstile-site-key>
TURNSTILE_SECRET_KEY=<private-turnstile-secret-key>

# Ventora CRM feedback widget. Set NEXT_PUBLIC_CRM_WIDGET_KEY to the product's
# widget public key (issued by the CRM operator). Leave blank to disable the widget.
# NEXT_PUBLIC_CRM_LOADER_URL defaults to https://widgets.ventoralabs.com/w/v1.js when unset.
NEXT_PUBLIC_CRM_WIDGET_KEY=
NEXT_PUBLIC_CRM_LOADER_URL=https://widgets.ventoralabs.com/w/v1.js

# Optional monitoring.
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=lextract-frontend
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
