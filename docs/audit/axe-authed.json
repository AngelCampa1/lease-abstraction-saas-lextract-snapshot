await (async page => {
  const surfaces = [
    ['https://lextract.io/dashboard', '06a-dashboard-desktop-light', 'light', 1440, 900],
    ['https://lextract.io/dashboard', '06b-dashboard-desktop-dark',  'dark',  1440, 900],
    ['https://lextract.io/dashboard', '06c-dashboard-mobile-light',  'light', 390, 900],
    ['https://lextract.io/profile',   '07a-profile-desktop-light',   'light', 1440, 900],
    ['https://lextract.io/profile',   '07b-profile-desktop-dark',    'dark',  1440, 900],
    ['https://lextract.io/profile',   '07c-profile-mobile-light',    'light', 390, 900],
    ['https://lextract.io/upload',    '05d-upload-authed-desktop',   'light', 1440, 900],
  ];
  const out = {};
  for (const [url, name, theme, vw, vh] of surfaces) {
    try {
      await page.setViewportSize({ width: vw, height: vh });
      await page.evaluate(t => { try { localStorage.setItem('theme', t); } catch {} }, theme);
      await page.goto(url, { waitUntil: 'networkidle', timeout: 25000 }).catch(()=>{});
      await page.waitForTimeout(700);
      await page.evaluate(t => { document.documentElement.classList.remove('light','dark'); document.documentElement.classList.add(t); }, theme);
      await page.waitForTimeout(200);
      await page.screenshot({ path: `docs/audit/${name}.png`, fullPage: true });
      await page.addScriptTag({ path: '<repo-root>/docs/audit/vendor/axe.min.js' });
      const axe = await page.evaluate(async () => {
        const r = await window.axe.run(document, { resultTypes: ['violations'] });
        return r.violations.map(v => ({ id:v.id, impact:v.impact, help:v.help, count:v.nodes.length, sample: v.nodes.slice(0,3).map(n => ({ target:n.target, summary:(n.failureSummary||'').slice(0,260) })) }));
      });
      out[name] = { url, axe, violationCount: axe.reduce((a,x)=>a+x.count,0), finalUrl: page.url() };
    } catch (e) { out[name] = { url, error: String(e).slice(0,200) }; }
  }
  return JSON.stringify(out, null, 2);
})(page);
