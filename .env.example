# =============================================================================
# Lextract — Root Environment Variables
# Copy this file to .env and fill in real values.
#
# This file documents the env vars needed by BOTH frontend and backend.
# For backend-only vars with more detail, see backend/.env.example.
#
# Legend:  [REQUIRED] = app will not start without this
#          [optional] = safe to leave blank; feature will be disabled
# =============================================================================

# === Backend ===

# [REQUIRED in production] Cloudflare Hyperdrive binding name for Neon Postgres.
# Local scripts and migrations can use a direct Neon DATABASE_URL outside Worker runtime.
HYPERDRIVE=lextract-neon

# [REQUIRED] Neon Auth (managed Better Auth) — backend verifies sessions against this
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.build/neondb/auth

# [REQUIRED in production] Cloudflare R2 binding name for document storage.
DOCUMENTS_BUCKET=lextract-documents

# [REQUIRED] OpenRouter — multi-pass extraction pipeline (Gemini 3 Flash + others).
# All LLM calls route through OpenRouter. See backend/.env.example for full config.
OPENROUTER_API_KEY=sk-or-...

# [REQUIRED] Stripe — payment processing for per-lease credits
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# [optional] Resend — transactional email (welcome, receipt). Disabled if blank.
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=Angel Campa <angel.campa@lextract.io>

# [REQUIRED for marketing captures] Cloudflare Worker backed by D1.
MARKETING_WORKER_URL=https://lextract-marketing-data.<account>.workers.dev
MARKETING_WORKER_SECRET=change-me-in-cloudflare-and-app-envs

# [optional] Sentry — error tracking. Disabled if blank.
SENTRY_DSN=

# === Frontend ===

# [REQUIRED] API base URL — must include /api/v1 because frontend clients
# append endpoint paths such as /extractions and /leads/unsubscribe.
NEXT_PUBLIC_API_URL=https://api.lextract.io/api/v1

# [REQUIRED] Neon Auth cookie secret — used to encrypt the auth session cookie.
# Must be at least 32 characters. Shared secret between frontend and Neon Auth.
NEON_AUTH_COOKIE_SECRET=your-secret-at-least-32-characters-long

# [optional] Sentry — frontend error tracking. Disabled unless enabled and DSN is set.
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
# [optional] Sentry source map upload during frontend builds. Builds still pass if blank.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# [optional] PostHog — product analytics and feature flags. Disabled if blank.
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# [optional] Backend PostHog capture for server-confirmed events, such as Stripe
# webhook payment success. Disabled if blank.
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://us.i.posthog.com
