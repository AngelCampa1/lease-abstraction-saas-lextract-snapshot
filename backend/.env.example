# =============================================================================
# Lextract Backend — Environment Variables
# Copy this file to .env and fill in real values before running the server.
#
# Legend:  [REQUIRED] = server will not start or core features break without this
#          [optional] = safe to leave blank; feature will be disabled
# =============================================================================

# --- App metadata ---
APP_NAME=Lextract API
ENVIRONMENT=development          # development | test | staging | production
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=text                  # text | json  (use json in production)

# --- CORS ---
# [REQUIRED in production] Comma-separated list of allowed origins.
# In development mode, http://localhost:3000 and http://localhost:8000 are
# auto-appended regardless of this setting.
#
# Production example (set this explicitly — do NOT rely on auto-append):
#   CORS_ORIGINS=["https://lextract.io","https://www.lextract.io"]
#
# The auto-append behavior ONLY activates when ENVIRONMENT=development.
# In production/staging, only origins listed here are allowed.
# CORS_ORIGINS=["https://lextract.io","https://www.lextract.io"]

# --- Neon.tech Database (PostgreSQL 15 through Cloudflare Hyperdrive) ---
# [REQUIRED in production] Runtime database access uses the HYPERDRIVE binding.
# Use a direct Neon DATABASE_URL only for local development and migrations.
HYPERDRIVE=lextract-neon

# --- Neon Auth (managed Better Auth) ---
# [REQUIRED] Backend verifies user sessions against this URL.
# Must match the NEON_AUTH_BASE_URL in the root .env.example used by frontend.
NEON_AUTH_BASE_URL=https://<project-id>.neonauth.us-east-2.aws.neon.build/neondb/auth

# --- Cloudflare R2 object storage ---
# [REQUIRED in production] Runtime storage access uses the DOCUMENTS_BUCKET binding.
DOCUMENTS_BUCKET=lextract-documents

# --- OpenRouter (multi-pass extraction pipeline) ---
# [REQUIRED] OpenRouter API key. All LLM calls route through OpenRouter.
# Routes requests to multiple LLM providers (Gemini, GPT, MiniMax, etc.)
# for the 3-pass extraction pipeline. See PASS1/2/3 model settings below.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Multi-pass extraction pipeline ---
MULTI_PASS_ENABLED=true
VALIDATION_MIN_CONFIDENCE=0.70
ESCALATION_CONFIDENCE_THRESHOLD=0.80

# Pass 1: Full extraction
PASS1_MODEL=google/gemini-3-flash-preview
PASS1_FALLBACK_MODEL=google/gemini-3.1-flash-lite-preview
PASS1_FALLBACK_MODEL_2=openai/gpt-5.4-mini

# Pass 2: Adversarial validation
PASS2_MODEL=google/gemini-3.1-flash-lite-preview
PASS2_FALLBACK_MODEL=openai/gpt-5.4-mini
PASS2_FALLBACK_MODEL_2=google/gemini-3-flash-preview

# Pass 3: Escalation — conditional, only fires for low-confidence fields
PASS3_MODEL=google/gemini-3-flash-preview
PASS3_FALLBACK_MODEL=google/gemini-3.1-flash-lite-preview
PASS3_FALLBACK_MODEL_2=openai/gpt-5.4-mini

# --- Stripe ---
# [REQUIRED] Stripe secret key for payment processing. Use sk_live_... in production.
STRIPE_SECRET_KEY=sk_test_...
# [REQUIRED] Stripe webhook signing secret for verifying webhook payloads
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Resend (transactional email) ---
# [optional] Resend API key. If blank, email sending is disabled (welcome, receipt emails).
RESEND_API_KEY=re_...
RESEND_FROM_ADDRESS=Angel Campa <angel.campa@lextract.io>

# --- Marketing data Worker (Cloudflare D1) ---
# [REQUIRED for /api/v1/leads compatibility endpoints]
MARKETING_WORKER_URL=https://lextract-marketing-data.<account>.workers.dev
MARKETING_WORKER_SECRET=change-me-in-cloudflare-and-app-envs

# Keep the legacy Neon leads table until the Worker is deployed, these vars are
# present in every runtime, and existing leads have been backfilled to D1.

# --- Rate limiting ---
RATE_LIMIT_AUTH=100              # requests per minute for authenticated users
RATE_LIMIT_ANON=20               # requests per minute for anonymous users

# --- URLs ---
# [REQUIRED] Frontend URL used in email links and CORS. Set to https://lextract.io in prod.
FRONTEND_URL=http://localhost:3000

# --- Sentry (optional — leave empty to disable) ---
SENTRY_DSN=

# --- CamAudit integration (optional — internal) ---
CAMAUDIT_SHARED_KEY=
CAMAUDIT_BASE_URL=https://camaudit.io

# --- Ventora AI-SDR product context (server-to-server) ---
AI_SDR_CONTEXT_SECRET=replace-with-shared-ai-sdr-context-secret
